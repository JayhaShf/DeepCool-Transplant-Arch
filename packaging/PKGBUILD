# Maintainer: Jay <jay@localhost>
# The release builder replaces __SOURCE_TAR_SHA256__ in dist/PKGBUILD.
pkgname=deepcool-linux-port
pkgver=0.1.0
pkgrel=2
pkgdesc="Arch Linux x86_64 compatibility port for the DeepCool 1.2.12 Electron UI"
arch=('x86_64')
url="https://github.com/JayhaShf/DeepCool-Transplant-Arch"
license=('custom')
install="$pkgname.install"
options=('!strip')
depends=(
  'acl'
  'alsa-lib'
  'at-spi2-core'
  'bash'
  'cairo'
  'curl'
  'dbus'
  'expat'
  'ffmpeg'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'python-pillow'
  'python-psutil'
  'python-pyusb'
  'shadow'
  'systemd'
)
makedepends=(
  'nodejs'
  'npm'
  '7zip'
  'zstd'
)
source=(
  "deepcool-linux-port-${pkgver}-source.tar.zst"
  'DeepCool-1.2.12-setup.exe'
)
noextract=('DeepCool-1.2.12-setup.exe')
sha256sums=(
  '__SOURCE_TAR_SHA256__'
  '4549885c716e951dde488e2117823478f7994c475e686331f93866582f6b116f'
)

build() {
  cd "$srcdir"
  npm ci --no-audit --no-fund
  APP_DIR="$srcdir/work/app-payload" \
    bash scripts/extract.sh "$srcdir/DeepCool-1.2.12-setup.exe"
  bash scripts/prepare.sh "$srcdir/work/app-payload"
  install -d "$srcdir/work"
  ln -sfn "$srcdir/work/app-payload" "$srcdir/work/windows-app"
  npm test
  npm run security:check
}

package() {
  local PREFIX="/opt/$pkgname"
  local EXTRACTED="$srcdir/work/app-payload/resources/app.asar.extracted"
  install -d "$pkgdir$PREFIX/app/resources"
  cp -a "$EXTRACTED" "$pkgdir$PREFIX/app/resources/app.asar.extracted"
  find "$pkgdir$PREFIX/app/resources/app.asar.extracted" -name '*.orig' -delete
  cp -a "$srcdir/node_modules/electron/dist" "$pkgdir$PREFIX/electron"
  install -d "$pkgdir$PREFIX/scripts" "$pkgdir$PREFIX/bin"
  cp "$srcdir"/scripts/{run.sh,verify.sh,prepare.sh,security-check.sh,install-user.sh,install-autostart.sh,uninstall-user.sh,uninstall-autostart.sh,reinstall-daemon.sh,disable-native-render.sh} \
     "$pkgdir$PREFIX/scripts/"
  cp -a "$srcdir"/{patches,daemon,tools} "$pkgdir$PREFIX/"
  cp "$srcdir"/{package-lock.json,README.md,SECURITY.md} "$pkgdir$PREFIX/"

  cat > "$pkgdir$PREFIX/bin/deepcool-linux-port" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
PREFIX="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export DEEPCOOL_APP_DIR="$PREFIX/app"
export DEEPCOOL_ELECTRON="$PREFIX/electron/electron"
exec "$PREFIX/scripts/run.sh" "$@"
EOF
  chmod +x "$pkgdir$PREFIX/bin/deepcool-linux-port"

  install -d "$pkgdir/usr/bin"
  ln -s "$PREFIX/bin/deepcool-linux-port" "$pkgdir/usr/bin/deepcool-linux-port"
  install -Dm0644 "$pkgdir$PREFIX/app/resources/app.asar.extracted/resources/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/deepcool-linux-port.png"
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/deepcool-linux-port.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=DeepCool (Linux Port)
Name[zh_CN]=DeepCool（Linux 移植版）
Comment=DeepCool 1.2.12 UI compatibility port for Arch Linux
Exec=/usr/bin/deepcool-linux-port
Icon=deepcool-linux-port
Terminal=false
StartupNotify=true
Categories=Settings;HardwareSettings;
StartupWMClass=DeepCool
EOF
  chmod 0644 "$pkgdir/usr/share/applications/deepcool-linux-port.desktop"

  install -Dm0755 "$srcdir/daemon/deepcool-lm-daemon.py" \
    "$pkgdir/usr/bin/deepcool-lm-daemon"
  install -d "$pkgdir/usr/lib/systemd/system"
  sed 's#/usr/local/bin/deepcool-lm-daemon#/usr/bin/deepcool-lm-daemon#' \
    "$srcdir/daemon/deepcool-lm-daemon.service" \
    > "$pkgdir/usr/lib/systemd/system/deepcool-lm-daemon.service"
  chmod 0644 "$pkgdir/usr/lib/systemd/system/deepcool-lm-daemon.service"
  grep -q 'ExecStart=/usr/bin/python3 /usr/bin/deepcool-lm-daemon' \
    "$pkgdir/usr/lib/systemd/system/deepcool-lm-daemon.service"

  install -Dm0644 "$srcdir/packaging/deepcool.sysusers" \
    "$pkgdir/usr/lib/sysusers.d/deepcool.conf"
  install -Dm0644 "$srcdir/packaging/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
