{
  "name": "deepcool-official-linux-port",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental Arch Linux compatibility port for DeepCool 1.2.12",
  "license": "UNLICENSED",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "extract": "bash scripts/extract.sh",
    "port:prepare": "bash scripts/prepare.sh",
    "start": "bash scripts/run.sh",
    "start:debug": "DEEPCOOL_CDP=1 bash scripts/run.sh",
    "verify": "bash scripts/verify.sh",
    "install:user": "bash scripts/install-user.sh",
    "uninstall:user": "bash scripts/uninstall-user.sh",
    "install:autostart": "bash scripts/install-autostart.sh",
    "uninstall:autostart": "bash scripts/uninstall-autostart.sh",
    "background": "bash scripts/run.sh --hidden"
  },
  "devDependencies": {
    "@electron/asar": "3.2.17",
    "electron": "23.3.13"
  }
}
