[Unit]
Description=DeepCool LM-Series LCD daemon (Linux Python port)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/deepcool-lm-daemon
Group=deepcool
UMask=0007
Restart=always
RestartSec=3
RuntimeDirectory=deepcool-lm
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
